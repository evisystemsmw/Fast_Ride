rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any authenticated user can read settings
    match /settings/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Rides: any authenticated user can read/create; updates restricted by role
    match /rides/{rideId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid ||
         request.resource.data.driverId == request.auth.uid ||
         request.resource.data.status == 'cancelled');
      allow delete: if false;
    }

    // Drivers: any authenticated user can read; driver can only write their own doc
    match /drivers/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Users: user can read/write their own doc
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /favourites/{favId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // SOS chats
    match /sos_chats/{chatId} {
      allow read, write: if request.auth != null;
      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, write: if request.auth != null;
    }
  }
}
